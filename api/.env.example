# ==========================================
# CONFIGURACIÓN DEL SERVIDOR API
# ==========================================

# Puerto del servidor
PORT=3001

# Ambiente de ejecución
NODE_ENV=development

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:19006

# ==========================================
# CONFIGURACIÓN DE HYPERLEDGER FABRIC
# ==========================================

# Ruta al directorio de la red de prueba de Fabric
FABRIC_NETWORK_PATH=../fabric-samples/test-network

# Ruta al wallet de usuarios
FABRIC_WALLET_PATH=../wallet

# ID del usuario para conectar con Fabric
FABRIC_USER_ID=User1

# Nombre del canal de Fabric
CHANNEL_NAME=mychannel

# Nombre del chaincode
CHAINCODE_NAME=foodtraceability

# MSP ID de la organización
FABRIC_MSP_ID=Org1MSP

# Endpoint del peer
FABRIC_PEER_ENDPOINT=grpc://localhost:7051

# Endpoint del CA
FABRIC_CA_ENDPOINT=http://localhost:7054

# ==========================================
# CONFIGURACIÓN DE SEGURIDAD
# ==========================================

# Clave secreta para JWT (generar una fuerte en producción)
JWT_SECRET=your-very-strong-secret-key-here-change-in-production

# Duración del token JWT (en segundos)
JWT_EXPIRES_IN=86400

# ==========================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ==========================================

# Configuración de email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Configuración de notificaciones push
PUSH_NOTIFICATION_KEY=your-push-notification-key

# ==========================================
# CONFIGURACIÓN DE LOGGING
# ==========================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Directorio para logs
LOG_DIR=./logs

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================

# URL de MongoDB para cache (opcional)
MONGODB_URL=mongodb://localhost:27017/foodtraceability

# ==========================================
# CONFIGURACIÓN DE DESARROLLO
# ==========================================

# Habilitar debugging detallado
DEBUG=false

# Habilitar CORS en desarrollo
ENABLE_CORS=true

# Mostrar stack traces en errores
SHOW_STACK_TRACES=true