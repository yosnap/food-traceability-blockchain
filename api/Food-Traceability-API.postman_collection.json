    {
      "name": "🍎 Food Products",
      "item": [
        {
          "name": "Ping Chaincode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{producerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/food/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "food", "ping"]
            }
          },
          "response": []
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique product ID",
                  "pm.globals.set(\"productId\", \"PROD-\" + Date.now());",
                  "pm.globals.set(\"batchNumber\", \"BATCH-2024-\" + Date.now());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{producerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\",\n  \"batchNumber\": \"{{batchNumber}}\",\n  \"name\": \"Tomates Cherry Orgánicos\",\n  \"category\": \"VEGETABLES\",\n  \"description\": \"Tomates cherry cultivados orgánicamente\",\n  \"quantity\": 100,\n  \"productionDate\": \"2025-06-29\",\n  \"expirationDate\": \"2025-07-05\",\n  \"origin\": {\n    \"farm\": \"Finca El Sol\",\n    \"location\": \"Almería, España\",\n    \"coordinates\": {\n      \"lat\": 36.8381,\n      \"lng\": -2.4597\n    }\n  },\n  \"storageConditions\": {\n    \"temperature\": \"4-8°C\",\n    \"humidity\": \"85-90%\",\n    \"requirements\": [\"Refrigeración\", \"Ventilación\"]\n  },\n  \"allergens\": [],\n  \"weight\": 5.0,\n  \"volume\": 2.5,\n  \"brand\": \"Orgánicos El Sol\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/food/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "food", "products"]
            }
          },
          "response": []
        },
